<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar">
        <!-- Enable platform splash screen on API 31+ -->
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenAnimationDuration">200</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_icon_background</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/img_app_icon</item>
        <!-- Post-splash theme -->
        <item name="android:windowSplashScreenBehavior">icon_preferred</item>
    </style>
</resources>