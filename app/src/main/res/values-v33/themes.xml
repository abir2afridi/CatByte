<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar">
        <!-- Enable platform splash screen on API 31+ -->
        <item name="android:windowSplashScreenBackground">#0D0E12</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_app_logo</item>
        <item name="android:windowSplashScreenAnimationDuration">200</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#0D0E12</item>
        <!-- Post-splash theme -->
        <item name="android:windowSplashScreenBehavior">icon_preferred</item>
    </style>
</resources>
