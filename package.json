{
  "name": "catbyte-video-editor",
  "version": "0.1.0",
  "description": "Professional video editor built with Tauri, React, and FFmpeg",
  "type": "module",
  "main": "src/main.tsx",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
