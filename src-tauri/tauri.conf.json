{
  "$schema": "https://tauri.app/schema/tauri.config.json",
  "identifier": "com.catbyte.videoeditor",
  "version": "0.1.0",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CatByte Video Editor",
        "width": 1600,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "dialog": {
      "all": true,
      "open": true,
      "save": true
    },
    "fs": {
      "all": true,
      "readDir": true,
      "readFile": true,
      "writeFile": true,
      "createDir": true,
      "removeFile": true,
      "removeDir": true,
      "copyFile": true,
      "scope": ["$APPDATA/*", "$HOME/*", "$TEMP/*"]
    },
    "shell": {
      "all": true,
      "open": true,
      "command": true
    },
    "opener": {
      "all": true
    }
  }
}